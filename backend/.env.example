# 本项目独立配置，可复制为 backend/.env。
# 地址、Key、模型名由用户提供，不读取或复制 Codex / 其他应用的凭证。
# API Key 只放在后端，不放入前端。
DOGHUNT_APP_NAME=Operation DogHunt
DOGHUNT_ENVIRONMENT=development
# 填写中转站提供的 API 根地址；程序在后面添加 /responses。
# 如果供应商要求 /v1，请将 /v1 保留在根地址中。
DOGHUNT_MODEL_BASE_URL=
DOGHUNT_MODEL_API_KEY=
DOGHUNT_MODEL_NAME=
# 思考强度默认 high（高）；可选 none/minimal/low/medium/high/xhigh，须由模型和中转站支持。
DOGHUNT_MODEL_REASONING_EFFORT=high
# 仅供应商要求额外认证头时填写；可能包含秘密，不可提交真实值。
DOGHUNT_MODEL_EXTRA_HEADERS='{}'
DOGHUNT_MODEL_TIMEOUT_SECONDS=120
DOGHUNT_MODEL_MAX_OUTPUT_TOKENS=4096
# 已有盘口脚本仍读取项目根目录 .env.local。

# ---- 本机数据库与向量库（deploy/compose.dev.yml，用法见 deploy/README.md）----
# Docker Compose 用 --env-file backend/.env 读取下面的密码，后端以后也读同一个值，避免两处密码。
# 必填：本机自己生成一个随机密码，只写在 backend/.env，不要提交。
DOGHUNT_DB_PASSWORD=
# 宿主机端口，留空用默认值；端口冲突时改这里（只绑 127.0.0.1），改完重新 up -d。
# DOGHUNT_DB_PORT 编排、make storage-check 和后端都读；两个 Milvus 端口只给编排和检查用，后端读下面的 DOGHUNT_MILVUS_URI。
# DOGHUNT_DB_PORT=5432
# DOGHUNT_MILVUS_PORT=19530
# DOGHUNT_MILVUS_HEALTH_PORT=9091
# 后端连接 PostgreSQL（P2）：下面是默认值，和 compose 一致时不用填。后端用它们和上面的密码拼连接串，
# 日志与 /api/v1/health/storage 只显示去掉密码的形式。改了要重启后端（配置有缓存）。
# DOGHUNT_DB_HOST=127.0.0.1
# DOGHUNT_DB_USER=doghunt
# DOGHUNT_DB_NAME=doghunt
# DOGHUNT_DB_POOL_SIZE=5
# DOGHUNT_DB_POOL_TIMEOUT_SECONDS=10
# DOGHUNT_DB_STATEMENT_TIMEOUT_MS=2000
# DOGHUNT_DB_ECHO=false
# 启动时做一次 SELECT 1（最多等 1 秒，连不上只记 warning，不影响启动）。
# DOGHUNT_DB_STARTUP_CHECK=true
# 可选：整条连接串覆盖上面各项，主要给测试用；不要把带密码的串提交到仓库。
# DOGHUNT_DATABASE_URL=

# 后端连接 Milvus（P4，开发文档第 8、12.2 节）：下面是默认值，和 compose 一致时不用填。
# 改了 DOGHUNT_MILVUS_PORT 要同步改 URI。日志与 /api/v1/health/storage 只显示去掉账号密码的地址。
# DOGHUNT_MILVUS_URI=http://127.0.0.1:19530
# 本机 Milvus 没开认证，留空；以后启用认证再填（启动时登记脱敏），不要提交真实值。
# DOGHUNT_MILVUS_TOKEN=
# DOGHUNT_MILVUS_DB_NAME=default
# 代码只用别名；集合名是 <别名>_<版本>，由 make memory-init 创建。
# DOGHUNT_MILVUS_CHILD_ALIAS=doghunt_memory_child
# DOGHUNT_MILVUS_PARENT_ALIAS=doghunt_memory_parent
# DOGHUNT_MILVUS_COLLECTION_VERSION=v1
# 连接/检索超时（秒）。
# DOGHUNT_MILVUS_TIMEOUT_SECONDS=2
# 启动时查一次别名、维度和加载状态，未 load 就 load 一次（最多等 1 秒，失败只记 warning，不影响启动）。
# DOGHUNT_MILVUS_STARTUP_CHECK=true
# milvus / fake；fake 是内存假实现，不连 Milvus（离线测试强制 fake）。
# DOGHUNT_VECTORSTORE_PROVIDER=milvus
# 向量维度，必须与集合一致（BGE-M3 为 1024）；不一致时 memory-init 报错退出，不自动重建。
# DOGHUNT_EMBEDDING_DIM=1024
